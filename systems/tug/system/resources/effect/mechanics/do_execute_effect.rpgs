      stat == "$character.spell_slots_9" -> setStat(stat = "$character.spell_slots_9", new_value = if is_passive then constant else roll(formula = dice_roll.formula), calculated_aggregation_type = aggregation_type),
      stat == "$character.max_spell_slots_1_bonus" -> setStat(stat = "$character.max_spell_slots_1_bonus", new_value = if is_passive then constant else roll(formula = dice_roll.formula), calculated_aggregation_type = aggregation_type),
      stat == "$character.max_spell_slots_2_bonus" -> setStat(stat = "$character.max_spell_slots_2_bonus", new_value = if is_passive then constant else roll(formula = dice_roll.formula), calculated_aggregation_type = aggregation_type),
      stat == "$character.max_spell_slots_3_bonus" -> setStat(stat = "$character.max_spell_slots_3_bonus", new_value = if is_passive then constant else roll(formula = dice_roll.formula), calculated_aggregation_type = aggregation_type),
      stat == "$character.max_spell_slots_4_bonus" -> setStat(stat = "$character.max_spell_slots_4_bonus", new_value = if is_passive then constant else roll(formula = dice_roll.formula), calculated_aggregation_type = aggregation_type),
      stat == "$character.max_spell_slots_5_bonus" -> setStat(stat = "$character.max_spell_slots_5_bonus", new_value = if is_passive then constant else roll(formula = dice_roll.formula), calculated_aggregation_type = aggregation_type),
