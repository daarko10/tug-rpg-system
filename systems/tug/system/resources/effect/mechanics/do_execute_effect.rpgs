      stat == "$character.max_spell_slots_9_bonus" -> addToStat(stat = "$character.max_spell_slots_9_bonus", value = if is_passive then constant else roll(formula = dice_roll.formula), calculated_aggregation_type = aggregation_type),
    },
    type == "set_stat" -> when {
      stat == "$character.strength_score" -> setStat(stat = "$character.strength_score", new_value = if is_passive then constant else roll(formula = dice_roll.formula), calculated_aggregation_type = aggregation_type),
      stat == "$character.strength_saving_throw" -> setStat(stat = "$character.strength_saving_throw", new_value = if is_passive then constant else roll(formula = dice_roll.formula), calculated_aggregation_type = aggregation_type),
      stat == "$character.dexterity_score" -> setStat(stat = "$character.dexterity_score", new_value = if is_passive then constant else roll(formula = dice_roll.formula), calculated_aggregation_type = aggregation_type),
      stat == "$character.dexterity_saving_throw" -> setStat(stat = "$character.dexterity_saving_throw", new_value = if is_passive then constant else roll(formula = dice_roll.formula), calculated_aggregation_type = aggregation_type),
      stat == "$character.constitution_score" -> setStat(stat = "$character.constitution_score", new_value = if is_passive then constant else roll(formula = dice_roll.formula), calculated_aggregation_type = aggregation_type),
      stat == "$character.constitution_saving_throw" -> setStat(stat = "$character.constitution_saving_throw", new_value = if is_passive then constant else roll(formula = dice_roll.formula), calculated_aggregation_type = aggregation_type),
      stat == "$character.wisdom_score" -> setStat(stat = "$character.wisdom_score", new_value = if is_passive then constant else roll(formula = dice_roll.formula), calculated_aggregation_type = aggregation_type),
      stat == "$character.wisdom_saving_throw" -> setStat(stat = "$character.wisdom_saving_throw", new_value = if is_passive then constant else roll(formula = dice_roll.formula), calculated_aggregation_type = aggregation_type),
      stat == "$character.intelligence_score" -> setStat(stat = "$character.intelligence_score", new_value = if is_passive then constant else roll(formula = dice_roll.formula), calculated_aggregation_type = aggregation_type),
      stat == "$character.intelligence_saving_throw" -> setStat(stat = "$character.intelligence_saving_throw", new_value = if is_passive then constant else roll(formula = dice_roll.formula), calculated_aggregation_type = aggregation_type),
