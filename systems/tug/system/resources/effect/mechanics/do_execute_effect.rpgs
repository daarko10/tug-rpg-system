mechanic do_execute_effect(
  event_names = "do_execute_effect",
  revert_event_names = "revert_effect_execution",
  calculated_revert_event_names = trigger_revert_events,
  revert_on_remove = clear_on_remove) =
  when {
    type == "add_to_stat" -> when {
      stat == "$character.strength_score" -> addToStat(stat = "$character.strength_score", value = if is_passive then constant else roll(formula = dice_roll.formula), calculated_aggregation_type = aggregation_type),
      stat == "$character.strength_saving_throw" -> addToStat(stat = "$character.strength_saving_throw", value = if is_passive then constant else roll(formula = dice_roll.formula), calculated_aggregation_type = aggregation_type),
      stat == "$character.dexterity_score" -> addToStat(stat = "$character.dexterity_score", value = if is_passive then constant else roll(formula = dice_roll.formula), calculated_aggregation_type = aggregation_type),
