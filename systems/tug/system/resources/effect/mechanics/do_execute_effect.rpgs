      stat == "$character.intelligence_saving_throw" -> addToStat(stat = "$character.intelligence_saving_throw", value = if is_passive then constant else roll(formula = dice_roll.formula), calculated_aggregation_type = aggregation_type),
      stat == "$character.charisma_score" -> addToStat(stat = "$character.charisma_score", value = if is_passive then constant else roll(formula = dice_roll.formula), calculated_aggregation_type = aggregation_type),
