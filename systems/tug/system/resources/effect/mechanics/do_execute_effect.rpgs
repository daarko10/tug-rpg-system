      stat == "$character.max_spell_slots_7_bonus" -> setStat(stat = "$character.max_spell_slots_7_bonus", new_value = if is_passive then constant else roll(formula = dice_roll.formula), calculated_aggregation_type = aggregation_type),
      stat == "$character.max_spell_slots_8_bonus" -> setStat(stat = "$character.max_spell_slots_8_bonus", new_value = if is_passive then constant else roll(formula = dice_roll.formula), calculated_aggregation_type = aggregation_type),
      stat == "$character.max_spell_slots_9_bonus" -> setStat(stat = "$character.max_spell_slots_9_bonus", new_value = if is_passive then constant else roll(formula = dice_roll.formula), calculated_aggregation_type = aggregation_type),
    },
    type == "advantage" -> addToStat(
      stat = "$character.advantages",
      value = [replace(string = advantage_stat, occurrence = "$character.", replace = "")],
      aggregation_type = "sum",
    ),
    type == "disadvantage" -> addToStat(
      stat = "$character.disadvantages",
      value = [replace(string = advantage_stat, occurrence = "$character.", replace = "")],
      aggregation_type = "sum",
    ),
    type == "add_spell" -> when {
      defined(stat = "spell") -> setStat(
        stat = "$character.spells",
        new_value = if contains(
          needle = spell.name,
          haystack = map($character.spells, mapper = ($mapValue) => $mapValue.name),
        )
          then $character.spells
          else append(list = $character.spells, item = spell),
        aggregation_type = "set",
      ),
    },
    type == "use_spell" -> when {
      defined(stat = "spell") -> showResource(resource = spell),
    },
  };
