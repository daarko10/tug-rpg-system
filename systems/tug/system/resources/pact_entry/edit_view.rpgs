view pact_entry_edit() =
  list(
    id = "pact_entry_edit",
    padding = 16,
    subviews = [
      composite(
        id = "pact_entry_edit_pact_comp",
        subviews = [
          text(
            id = "pact_entry_edit_pact_label",
            text = "Pact: ",
            style = "text",
            bold = true,
          ),
          select(
            id = "pact_entry_edit_pact_select",
            stat = "pact_id",
            options = "pact_types",
          ),
        ],
      ),
      text(
        id = "pact_entry_edit_description",
        text = pact_description,
        style = "text",
        margin_top = 8,
        is_visible = !isEmpty(pact_description),
      ),
      text(
        id = "pact_entry_edit_buffs",
        text = pact_buffs_text,
        style = "text",
        bold = true,
        margin_top = 12,
        is_visible = !isEmpty(pact_buffs_text),
      ),
      composite(
        id = "pact_entry_edit_chosen_score_comp",
        subviews = [
          text(
            id = "pact_entry_edit_chosen_score_label",
            text = "Chosen ability score: ",
            style = "text",
          ),
          select(
            id = "pact_entry_edit_chosen_score_select",
            stat = "chosen_score",
            options = "ability",
          ),
        ],
        is_visible = pact_id == "physical_augmentation" || pact_id == "arcane_affinity",
      ),
      composite(
        id = "pact_entry_edit_damage_type_comp",
        subviews = [
          text(
            id = "pact_entry_edit_damage_type_label",
            text = "Pact damage type: ",
            style = "text",
          ),
          select(
            id = "pact_entry_edit_damage_type_select",
            stat = "primordial_damage_type",
            options = "primordial_damage_types",
          ),
        ],
        is_visible = pact_id == "primordial_pact",
      ),
      text(
        id = "pact_entry_edit_notes",
        edit_stat = "notes",
        style = "text",
        label = "Notes (backstory, pact lore, roleplaying details…)",
        hint = "Write anything about this pact…",
        margin_top = 16,
      ),
      text(
        id = "pact_entry_edit_features_hint",
        text = "Add Pact Features via the Cursed Pacts section on the character sheet.",
        style = "caption",
        margin_top = 24,
      ),
    ],
  );
