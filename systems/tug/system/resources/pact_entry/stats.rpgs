base string pact_id(name = "Pact ID") = "";

calc string name(name = "Name") =
  enumeratedName(enumerated_type = "pact_types", id = pact_id) ?? "";

calc string pact_name(name = "Pact Name") =
  enumeratedName(enumerated_type = "pact_types", id = pact_id) ?? "";

base string chosen_score(name = "Chosen score") = "";

base string primordial_damage_type(name = "Primordial damage type") = "";

base string notes(name = "Notes") = "";

calc string pact_description(name = "Pact description") =
  when {
    pact_id == "physical_augmentation" -> "Your body has been reforged through dark pact magic, granting supernatural physical capabilities beyond mortal limits. You gain enhanced strength, speed, and resilience — but at a price.",
    pact_id == "arcane_affinity" -> "You have bound yourself to the raw flow of arcane energy, gaining the ability to channel and amplify magical forces far beyond what ordinary study allows.",
    pact_id == "blood_manipulation" -> "Through your pact you have learned to control the vital essence of living creatures — including your own. Blood is power, and you have learned to spend it.",
    pact_id == "primordial_pact" -> "You have forged a bond with a primordial elemental force, channeling its raw destructive energy as your pact's weapon.",
    pact_id == "limitless" -> "You have pushed past the boundaries of mortal endurance — transcending your own limits in a burst of impossible power, paying for every inch with your vitality.",
    else -> "",
  };

calc string pact_buffs_text(name = "Pact buffs text") =
  when {
    pact_id == "physical_augmentation" -> concat([
      "+ Increase 1 physical ability score (STR, DEX, or CON) by +2",
      (if isEmpty(chosen_score) then "" else concat([" (", enumeratedName(enumerated_type = "ability", id = chosen_score) ?? chosen_score, ")"])),
      "\n- You can no longer cast spells",
    ]),
    pact_id == "arcane_affinity" -> concat([
      "+ Add your proficiency bonus to all spell damage rolls",
      "\n- One physical ability score (STR, DEX, or CON) becomes 5",
      (if isEmpty(chosen_score) then "" else concat([" (", enumeratedName(enumerated_type = "ability", id = chosen_score) ?? chosen_score, ")"])),
    ]),
    pact_id == "blood_manipulation" -> "+ Gain blood manipulation techniques (powered by your own HP)\n- Techniques cost your own HP to use",
    pact_id == "primordial_pact" -> concat([
      "+ Gain resistance to a chosen damage type",
      (if isEmpty(primordial_damage_type) then "" else concat([" (", primordial_damage_type, ")"])),
      "\n- Gain vulnerability to the two adjacent damage types on the elemental wheel",
    ]),
    pact_id == "limitless" -> "+ Gain expertise in Perception\n- You become permanently blind",
    else -> "",
  };
