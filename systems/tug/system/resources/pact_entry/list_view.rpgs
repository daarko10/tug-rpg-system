view pact_entry_list() =
  list(
    id = "pact_entry_list",
    subviews = [
      listItem(
        id = "pact_entry_list_data",
        title = pact_name,
        subtitle = concat([
          pact_description,
          (if isEmpty(chosen_score) then "" else concat(["\nChosen score: ", enumeratedName(enumerated_type = "ability", id = chosen_score) ?? chosen_score])),
          (if isEmpty(primordial_damage_type) then "" else concat(["\nDamage type: ", primordial_damage_type])),
        ]),
      ),
    ],
  );
