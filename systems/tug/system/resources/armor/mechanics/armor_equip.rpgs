mechanic armor_equip(event_names = "toggle_equip") =
  when {
    type == "shield" -> when {
      is_equipped -> setStat(stat = "$character.equipped_shield_id", new_value = "", aggregation_type = "set"),
      else -> setStat(stat = "$character.equipped_shield_id", new_value = id, aggregation_type = "set"),
    },
    else -> when {
      is_equipped -> setStat(stat = "$character.equipped_armor_id", new_value = "", aggregation_type = "set"),
      else -> setStat(stat = "$character.equipped_armor_id", new_value = id, aggregation_type = "set"),
    },
  };
