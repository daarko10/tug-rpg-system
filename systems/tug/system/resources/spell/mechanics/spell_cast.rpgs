mechanic spell_cast(name = "Cast spell", event_names = "castSpell") =
  sequence(
    effects = [
      when {
        !is_cantrip && character_sp_defined -> addToStat(
          stat = "$character.current_spell_points",
          value = -sp_cost_for_cast_level,
        ),
      },
      roll(
        rolls = [
          rollable(
            formulas = [spell_attack_roll_formula],
            text = "to hit",
          ),
        ],
      ),
    ],
  );
