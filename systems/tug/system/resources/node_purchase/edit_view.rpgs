view node_purchase_edit() =
  list(
    id = "node_purchase_edit",
    padding = 16,
    subviews = [
      selectResources(
        id = "node_purchase_edit_node_select",
        stat = "node",
        resource_id = "skill_tree_node",
      ),
      stat(
        id = "node_purchase_edit_purchase_index",
        stat = "purchase_index",
        override_label = "Investment #",
        min_value_allowed = 1,
      ),
    ],
  );
