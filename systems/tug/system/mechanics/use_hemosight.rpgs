mechanic use_hemosight(event_names = "use_hemosight") =
  sequence(
    effects = [
      when {
        !blood_manipulation_active -> showMessage(
          message = "Hemosight requires the Blood Manipulation pact.",
          message_type = "error",
        ),
        bm_hemosight_pp <= 0 -> showMessage(
          message = "You haven't invested PP in Hemosight.",
          message_type = "error",
        ),
        current_hp >= max_hp -> showMessage(
          message = "You must have below max HP to use Blood Manipulation techniques.",
          message_type = "error",
        ),
        max_hp <= 1 -> showMessage(
          message = "Sacrificing 1 max HP would reduce your maximum to 0. You would die.",
          message_type = "error",
        ),
        else -> sequence(
          effects = [
            setStat(
              stat = "blood_max_hp_debt",
              new_value = blood_max_hp_debt + 1,
              aggregation_type = "set",
            ),
            when {
              current_hp > max_hp - 1 -> setStat(
                stat = "current_hp",
                new_value = max_hp - 1,
                aggregation_type = "set",
              ),
            },
            showMessage(
              message = "Hemosight activated! Sacrificed 1 max HP.\nPlace a drop of blood on a non-porous surface — you can see through it as your own eye for 10 minutes.\nMax HP restored on long rest.",
              message_type = "info",
            ),
          ],
        ),
      },
    ],
  );
