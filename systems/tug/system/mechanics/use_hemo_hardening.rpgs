mechanic use_hemo_hardening(event_names = "use_hemo_hardening") =
  sequence(
    effects = [
      when {
        !blood_manipulation_active -> showMessage(
          message = "Hemo-Hardening requires the Blood Manipulation pact.",
          message_type = "error",
        ),
        bm_hemo_hardening_pp <= 0 -> showMessage(
          message = "You haven't invested PP in Hemo-Hardening.",
          message_type = "error",
        ),
        bm_hemo_hardening_cost <= 0 -> showMessage(
          message = "Set max HP to sacrifice (must be at least 5).",
          message_type = "error",
        ),
        current_hp >= max_hp -> showMessage(
          message = "You must have below max HP to use Blood Manipulation techniques.",
          message_type = "error",
        ),
        max_hp <= bm_hemo_hardening_cost -> showMessage(
          message = concat(["Sacrificing ", bm_hemo_hardening_cost, " max HP would reduce your maximum to 0. You would die."]),
          message_type = "error",
        ),
        else -> sequence(
          effects = [
            setStat(
              stat = "blood_max_hp_debt",
              new_value = blood_max_hp_debt + bm_hemo_hardening_cost,
              aggregation_type = "set",
            ),
            when {
              current_hp > max_hp - bm_hemo_hardening_cost -> setStat(
                stat = "current_hp",
                new_value = max_hp - bm_hemo_hardening_cost,
                aggregation_type = "set",
              ),
            },
            showMessage(
              message = concat([
                "Hemo-Hardening active! Sacrificed ",
                bm_hemo_hardening_cost,
                " max HP.\n+",
                hemo_hardening_ac_bonus,
                " AC until the start of your next turn (reaction).\nMax HP restored on long rest.",
              ]),
              message_type = "info",
            ),
          ],
        ),
      },
    ],
  );
