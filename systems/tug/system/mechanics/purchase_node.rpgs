mechanic purchase_node(event_names = "purchase_node") =
  sequence(
    effects = [
      when {
        pact_points_available <= 0 -> showMessage(
          message = "You have no Pact Points remaining to spend.",
          message_type = "error",
        ),
        else -> showMessage(
          message = concat(["Node purchased. ", pact_points_available - 1, " PP remaining."]),
          message_type = "info",
        ),
      },
    ],
  );
