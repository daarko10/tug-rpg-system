mechanic activate_domain(event_names = "activate_domain") =
  sequence(
    effects = [
      when {
        domain_activations_remaining <= 0 -> showMessage(
          message = "No domain activations remaining. Take a long rest to recover.",
          message_type = "error",
        ),
        current_hp < domain_activation_hp_cost -> showMessage(
          message = concat([
            "Not enough HP to activate the domain (costs ",
            domain_activation_hp_cost,
            " HP).",
          ]),
          message_type = "error",
        ),
        else -> sequence(
          effects = [
            setStat(
              stat = "domain_max_hp_debt",
              new_value = domain_max_hp_debt + domain_activation_hp_cost,
              aggregation_type = "set",
            ),
            setStat(
              stat = "current_hp",
              new_value = min([current_hp - domain_activation_hp_cost, max_hp - domain_activation_hp_cost]),
              aggregation_type = "set",
            ),
            setStat(
              stat = "domain_activations_remaining",
              new_value = domain_activations_remaining - 1,
              aggregation_type = "set",
            ),
            showMessage(
              message = concat([
                "Domain activated! ",
                domain_activation_hp_cost,
                " HP sacrificed (restores on long rest).",
                (if domain_infinite_void_pp > 0 then "\n⚠ Infinite Void: cost doubled!" else ""),
              ]),
              message_type = "info",
            ),
          ],
        ),
      },
    ],
  );
