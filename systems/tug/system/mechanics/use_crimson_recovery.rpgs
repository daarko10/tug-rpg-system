mechanic use_crimson_recovery(event_names = "use_crimson_recovery") =
  sequence(
    effects = [
      when {
        !blood_manipulation_active -> showMessage(
          message = "Crimson Recovery requires the Blood Manipulation pact.",
          message_type = "error",
        ),
        bm_crimson_recovery_pp <= 0 -> showMessage(
          message = "You haven't invested PP in Crimson Recovery.",
          message_type = "error",
        ),
        bm_recovery_hp_cost <= 0 -> showMessage(
          message = "Set max HP to sacrifice (must be at least 5).",
          message_type = "error",
        ),
        current_hp >= max_hp -> showMessage(
          message = "You must have below max HP to use Blood Manipulation techniques.",
          message_type = "error",
        ),
        max_hp <= bm_recovery_hp_cost -> showMessage(
          message = concat(["Sacrificing ", bm_recovery_hp_cost, " max HP would reduce your maximum to 0. You would die."]),
          message_type = "error",
        ),
        max_spell_points > 0 && current_spell_points >= max_spell_points -> showMessage(
          message = "Spell Points already at maximum.",
          message_type = "error",
        ),
        else -> sequence(
          effects = [
            setStat(
              stat = "blood_max_hp_debt",
              new_value = blood_max_hp_debt + bm_recovery_hp_cost,
              aggregation_type = "set",
            ),
            when {
              current_hp > max_hp - bm_recovery_hp_cost -> setStat(
                stat = "current_hp",
                new_value = max_hp - bm_recovery_hp_cost,
                aggregation_type = "set",
              ),
            },
            setStat(
              stat = "current_spell_points",
              new_value = min([current_spell_points + crimson_recovery_sp_restored, max([max_spell_points, current_spell_points + crimson_recovery_sp_restored])]),
              aggregation_type = "set",
            ),
            showMessage(
              message = concat([
                "Crimson Recovery! Sacrificed ",
                bm_recovery_hp_cost,
                " max HP → recovered ",
                crimson_recovery_sp_restored,
                " Spell Points (lv",
                crimson_recovery_slot_level,
                " slot equiv.).\nMax HP restored on long rest.",
              ]),
              message_type = "info",
            ),
          ],
        ),
      },
    ],
  );
