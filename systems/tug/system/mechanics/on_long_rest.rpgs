mechanic on_long_rest(event_names = "long_rest") =
  sequence(
    effects = [
      showMessage(
        message = "You're feeling well rested. Your HP, spell slots, hit dice and domain activations have been restored.",
        message_type = "info",
      ),
      setStat(stat = "current_hp", new_value = max_hp, aggregation_type = "set"),
      setStat(
        stat = "current_d8_hit_dice",
        new_value = min(
          [
            max_d8_hit_dice,
            (current_d8_hit_dice + max([divide([max_d8_hit_dice, 2], rounding_method = "down"), 1])),
          ],
        ),
        aggregation_type = "set",
      ),
      setStat(stat = "blood_max_hp_debt", new_value = 0, aggregation_type = "set"),
      setStat(stat = "domain_max_hp_debt", new_value = 0, aggregation_type = "set"),
      setStat(stat = "domain_activations_remaining", new_value = 1, aggregation_type = "set"),
      setStat(stat = "spell_slots_1", new_value = max_spell_slots_1_bonus, aggregation_type = "set"),
      setStat(stat = "spell_slots_2", new_value = max_spell_slots_2_bonus, aggregation_type = "set"),
      setStat(stat = "spell_slots_3", new_value = max_spell_slots_3_bonus, aggregation_type = "set"),
      setStat(stat = "spell_slots_4", new_value = max_spell_slots_4_bonus, aggregation_type = "set"),
      setStat(stat = "spell_slots_5", new_value = max_spell_slots_5_bonus, aggregation_type = "set"),
      setStat(stat = "spell_slots_6", new_value = max_spell_slots_6_bonus, aggregation_type = "set"),
      setStat(stat = "spell_slots_7", new_value = max_spell_slots_7_bonus, aggregation_type = "set"),
      setStat(stat = "spell_slots_8", new_value = max_spell_slots_8_bonus, aggregation_type = "set"),
      setStat(stat = "spell_slots_9", new_value = max_spell_slots_9_bonus, aggregation_type = "set"),
    ],
  );
