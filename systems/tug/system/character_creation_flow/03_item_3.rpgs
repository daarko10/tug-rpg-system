import "../macros/system_common.rpgs";

character_creation_page edit_build_a_base_title() =
  characterCreationPage(
    title = displayableData(id = "edit_build_a_base_title", name = "Build-a-Base"),
    view = list(
      id = "edit_build_a_base",
      padding = 32,
      subviews = [
        text(
          id = "edit_bab_subheader_saves",
          text = "Part A — Saving Throws: Choose 2 ability scores",
          style = "subhead",
        ),
        composite(
          id = "edit_bab_saves_comp",
          subviews = [
            select(
              id = "edit_bab_save_1",
              stat = "temp_saving_throw_1",
              options = "ability",
              margin_right = 8,
            ),
            text(
              id = "edit_bab_saves_and",
              text = " and ",
              style = "text",
            ),
            select(
              id = "edit_bab_save_2",
              stat = "temp_saving_throw_2",
              options = "ability",
            ),
          ],
        ),
        text(
          id = "edit_bab_saves_validation",
          text = "Please select 2 different ability scores for saving throw proficiency.",
          style = "text",
          color = "error",
          is_visible = !notNull($view.edit_bab_save_1) || !notNull($view.edit_bab_save_2) || $view.edit_bab_save_1 == $view.edit_bab_save_2,
        ),
        text(
          id = "edit_bab_subheader_points",
          text = "Part B — Spend 8 Base Points (BP)",
          style = "subhead",
          margin_top = 8,
        ),
        composite(
          id = "edit_bab_remaining_comp",
          subviews = [
            text(
              id = "edit_bab_remaining_label",
              text = "BP remaining: ",
              style = "text",
              bold = true,
            ),
            text(
              id = "edit_bab_remaining_value",
              text = concat(["", base_points_remaining]),
              style = "text",
              bold = true,
            ),
          ],
        ),
        text(
          id = "edit_bab_skills_header",
          text = "Skills & Tools (1 BP each)",
          style = "subhead",
          margin_top = 8,
        ),
        section(
          id = "edit_bab_skills_section",
          header = [],
          show_divider = false,
          content_item_min_width = 1,
          collapsible = false,
          content = [
            stat(
              id = "edit_bab_skill_proficiency_count",
              stat = "bab_skill_proficiency_count",
              override_label = "+1 Skill Proficiency (1 BP)",
              style = "list",
              min_value_allowed = 0,
            ),
            stat(
              id = "edit_bab_tool_proficiency_count",
              stat = "bab_tool_proficiency_count",
              override_label = "+1 Tool Proficiency (1 BP)",
              style = "list",
              min_value_allowed = 0,
            ),
            stat(
              id = "edit_bab_cantrip_count",
              stat = "bab_cantrip_count",
              override_label = "+1 Cantrip (1 BP)",
              style = "list",
              min_value_allowed = 0,
            ),
            stat(
              id = "edit_bab_language_count",
              stat = "bab_language_count",
              override_label = "+2 Extra Languages (1 BP)",
              style = "list",
              min_value_allowed = 0,
            ),
          ],
        ),
        text(
          id = "edit_bab_armor_header",
          text = "Armour Proficiencies",
          style = "subhead",
          margin_top = 8,
        ),
        checkbox(
          id = "edit_bab_heavy_armor",
          stat = "bab_heavy_armor",
          label = "Heavy Armour (includes Medium + Light) — 3 BP",
        ),
        checkbox(
          id = "edit_bab_medium_armor",
          stat = "bab_medium_armor",
          label = "Medium Armour (includes Light) — 2 BP",
        ),
        checkbox(
          id = "edit_bab_light_armor",
          stat = "bab_light_armor",
          label = "Light Armour — 1 BP",
        ),
        text(
          id = "edit_bab_weapon_header",
          text = "Weapon & Shield Proficiencies",
          style = "subhead",
          margin_top = 8,
        ),
        checkbox(
          id = "edit_bab_martial_weapons",
          stat = "bab_martial_weapons",
          label = "Martial Weapons (includes Simple) — 2 BP",
        ),
        checkbox(
          id = "edit_bab_simple_weapons",
          stat = "bab_simple_weapons",
          label = "Simple Weapons — 1 BP",
        ),
        checkbox(
          id = "edit_bab_shield",
          stat = "bab_shield",
          label = "Shield Proficiency — 1 BP",
        ),
        checkbox(
          id = "edit_bab_dagger_simple",
          stat = "bab_dagger_simple",
          label = "Daggers + 1 Simple Melee Weapon — Free",
        ),
        text(
          id = "edit_bab_feats_header",
          text = "Feats (4 BP each)",
          style = "subhead",
          margin_top = 8,
        ),
        section(
          id = "edit_bab_feats_section",
          header = [],
          show_divider = false,
          content_item_min_width = 1,
          collapsible = false,
          content = [
            stat(
              id = "edit_bab_feat_count",
              stat = "bab_feat_count",
              override_label = "+1 Feat (4 BP)",
              style = "list",
              min_value_allowed = 0,
            ),
          ],
        ),
      ],
    ),
    post_edit = sequence(
      effects = [
        when {
          temp_saving_throw_1 == "strength" -> setStat(stat = "strength_saving_throw_proficiency", new_value = true, aggregation_type = "set"),
          temp_saving_throw_1 == "dexterity" -> setStat(stat = "dexterity_saving_throw_proficiency", new_value = true, aggregation_type = "set"),
          temp_saving_throw_1 == "constitution" -> setStat(stat = "constitution_saving_throw_proficiency", new_value = true, aggregation_type = "set"),
          temp_saving_throw_1 == "intelligence" -> setStat(stat = "intelligence_saving_throw_proficiency", new_value = true, aggregation_type = "set"),
          temp_saving_throw_1 == "wisdom" -> setStat(stat = "wisdom_saving_throw_proficiency", new_value = true, aggregation_type = "set"),
          temp_saving_throw_1 == "charisma" -> setStat(stat = "charisma_saving_throw_proficiency", new_value = true, aggregation_type = "set"),
        },
        when {
          temp_saving_throw_2 == "strength" -> setStat(stat = "strength_saving_throw_proficiency", new_value = true, aggregation_type = "set"),
          temp_saving_throw_2 == "dexterity" -> setStat(stat = "dexterity_saving_throw_proficiency", new_value = true, aggregation_type = "set"),
          temp_saving_throw_2 == "constitution" -> setStat(stat = "constitution_saving_throw_proficiency", new_value = true, aggregation_type = "set"),
          temp_saving_throw_2 == "intelligence" -> setStat(stat = "intelligence_saving_throw_proficiency", new_value = true, aggregation_type = "set"),
          temp_saving_throw_2 == "wisdom" -> setStat(stat = "wisdom_saving_throw_proficiency", new_value = true, aggregation_type = "set"),
          temp_saving_throw_2 == "charisma" -> setStat(stat = "charisma_saving_throw_proficiency", new_value = true, aggregation_type = "set"),
        },
        when {
          bab_heavy_armor -> setStat(
            stat = "armor_proficiencies",
            new_value = flatAppend([armor_proficiencies, ["light", "medium", "heavy"]], treat_as_set = true),
            aggregation_type = "set",
          ),
        },
        when {
          bab_medium_armor && !bab_heavy_armor -> setStat(
            stat = "armor_proficiencies",
            new_value = flatAppend([armor_proficiencies, ["light", "medium"]], treat_as_set = true),
            aggregation_type = "set",
          ),
        },
        when {
          bab_light_armor && !bab_medium_armor && !bab_heavy_armor -> setStat(
            stat = "armor_proficiencies",
            new_value = flatAppend([armor_proficiencies, ["light"]], treat_as_set = true),
            aggregation_type = "set",
          ),
        },
        when {
          bab_shield -> setStat(
            stat = "armor_proficiencies",
            new_value = flatAppend([armor_proficiencies, ["shield"]], treat_as_set = true),
            aggregation_type = "set",
          ),
        },
        when {
          bab_martial_weapons -> setStat(
            stat = "weapon_proficiencies",
            new_value = flatAppend([weapon_proficiencies, ["all_simple", "all_martial"]], treat_as_set = true),
            aggregation_type = "set",
          ),
        },
        when {
          bab_simple_weapons && !bab_martial_weapons -> setStat(
            stat = "weapon_proficiencies",
            new_value = flatAppend([weapon_proficiencies, ["all_simple"]], treat_as_set = true),
            aggregation_type = "set",
          ),
        },
      ],
    ),
  );
