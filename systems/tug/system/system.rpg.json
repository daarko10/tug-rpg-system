  "progression_systems": {
    "experience_levelling_system": {
      "level_up_view_title": {
        "type": "concat",
        "components": {
          "type": "list",
          "components": [
            {
              "type": "constant",
              "value": "Level Up to ",
              "value_type": "string"
            },
            {
              "type": "add",
              "components": {
                "type": "list",
                "components": [
                  {
                    "type": "stat",
                    "stat": "level"
                  },
                  {
                    "type": "constant",
                    "value": 1,
                    "value_type": "integer"
                  }
                ]
              }
            }
          ]
        }
      },
      "level_up_button_text": "Level Up",
      "level_up_icon": "ic_progression",
      "level_up_icon_color": "#FFB300",
      "level_up_view": {
        "id": "level_up",
        "type": "list",
        "padding": 16,
        "subviews": [
          {
            "id": "level_up_pp_label",
            "type": "text",
            "text": {
              "type": "constant",
              "value": "You gain 1 Pact Point to spend in any skill tree.",
              "value_type": "string"
            },
            "style": "subhead",
            "margin_bottom": 8
          },
          {
            "id": "level_up_pp_total_comp",
            "type": "composite",
            "subviews": [
              {
                "id": "level_up_pp_total_label",
                "type": "text",
                "text": {
                  "type": "constant",
                  "value": "Pact Points after level up: ",
                  "value_type": "string"
                },
                "style": "text"
              },
              {
                "id": "level_up_pp_total_value",
                "type": "text",
                "text": {
                  "type": "add",
                  "components": {
                    "type": "list",
                    "components": [
                      {
                        "type": "stat",
                        "stat": "pact_points_total"
                      },
                      {
                        "type": "constant",
                        "value": 1,
                        "value_type": "integer"
                      }
                    ]
                  }
                },
                "style": "text",
                "bold": true
              }
            ]
          },
          {
            "id": "level_up_pp_available_comp",
            "type": "composite",
            "subviews": [
              {
                "id": "level_up_pp_available_label",
                "type": "text",
                "text": {
                  "type": "constant",
                  "value": "Available Pact Points: ",
                  "value_type": "string"
                },
                "style": "text"
              },
              {
                "id": "level_up_pp_available_value",
                "type": "text",
                "text": {
                  "type": "add",
                  "components": {
                    "type": "list",
                    "components": [
                      {
                        "type": "stat",
                        "stat": "pact_points_available"
                      },
                      {
                        "type": "constant",
                        "value": 1,
                        "value_type": "integer"
                      }
                    ]
                  }
                },
                "style": "text",
                "bold": true
              }
            ]
          }
        ]
      },
      "on_level_up_confirm": {
        "type": "sequence",
        "effects": [
          {
            "type": "addToStat",
            "stat": "level",
            "value": {
              "type": "constant",
              "value": 1,
              "value_type": "integer"
            },
            "aggregation_type": "set"
          },
          {
            "type": "addToStat",
            "stat": "base_hp",
            "value": {
              "type": "constant",
              "value": 5,
              "value_type": "integer"
            },
            "aggregation_type": "set"
          },
          {
            "type": "addToStat",
            "stat": "current_hp",
            "value": {
              "type": "constant",
              "value": 5,
              "value_type": "integer"
            },
            "aggregation_type": "set"
          },
          {
            "type": "addToStat",
            "stat": "max_d8_hit_dice",
            "value": {
              "type": "constant",
              "value": 1,
              "value_type": "integer"
            },
            "aggregation_type": "set"
          },
          {
            "type": "addToStat",
            "stat": "current_d8_hit_dice",
            "value": {
              "type": "constant",
              "value": 1,
              "value_type": "integer"
            },
            "aggregation_type": "set"
          },
          {
            "type": "showPopUp",
            "pop_up_view": {
              "id": "level_up_notice",
              "type": "list",
              "padding": 16,
              "subviews": [
                {
                  "id": "level_up_notice_text",
                  "type": "text",
                  "text": {
                    "type": "constant",
                    "value": "HP +5 (average d8). CON modifier applies automatically. You also gained 1 Pact Point — spend it in your skill trees.",
                    "value_type": "string"
                  },
                  "style": "text"
                }
              ]
            },
            "pop_up_type": "alert",
            "pop_up_title": {
              "type": "constant",
              "value": "Level Up!",
              "value_type": "string"
            },
            "cancel_text": {
              "type": "constant",
              "value": "OK",
              "value_type": "string"
            }
          }
        ]
      },
      "experience_name": "experience",
      "experience_abbreviation": "exp",
      "level_stat_name": "level",
      "milestones_system_name": "Milestones",
