character_sheet_section spells_sheet() =
  section(
    id = "spells_section",
    show_divider = true,
    content_item_min_width = 1,
    collapsible = true,
    header = [
      icon(
        id = "spells_section_icon",
        name = "ic_whatshot",
        color = "#7b1fa2",
        size = "medium",
        margin_top = 8,
        margin_right = 8,
        margin_left = 16,
      ),
      text(
        id = "spells_section_title",
        margin_right = 16,
        margin_left = 16,
        text = "Spells",
        style = "title",
      ),
      spacer(id = "spells_section_header_spacer"),
      selectResources(
        id = "spells_section_add_spell",
        stat = "spells",
        resource_id = "spell",
        view_type = "icon",
        should_append = true,
        should_save_on_selection = true,
      ),
    ],
    content = [
      // Spellcasting stats summary
      composite(
        id = "spellcasting_stats_row",
        margin_left = 16,
        margin_top = 4,
        margin_bottom = 8,
        subviews = [
          text(
            id = "spellcasting_ability_label",
            text = concat([
              enumeratedName(enumerated_type = "ability", id = spellcasting_ability) ?? spellcasting_ability,
            ]),
            style = "text",
            bold = true,
          ),
        ],
      ),
      composite(
        id = "spell_attack_dc_row",
        margin_left = 16,
        margin_bottom = 12,
        subviews = [
          text(
            id = "spell_attack_bonus_label",
            text = "Spell attack bonus: ",
            style = "text",
          ),
          text(
            id = "spell_attack_bonus_value",
            text = concat([toSignedString(spell_attack_bonus)]),
            style = "text",
            color = "accent",
          ),
          text(
            id = "spell_dc_separator",
            text = "    Spell save DC: ",
            style = "text",
          ),
          text(
            id = "spell_dc_value",
            text = concat([spell_save_dc_spells]),
            style = "text",
            color = "accent",
          ),
        ],
      ),
      resourceSection(
        id = "cantrips_list",
        resource_stat = "cantrips",
        resource_set_stat = "spells",
        resource_id = "spell",
        header_view = text(
          id = "cantrips_title",
          margin_left = 12,
          text = "Cantrips",
          style = "subhead",
          is_visible = !isEmpty(cantrips),
        ),
      ),
      resourceSection(
        id = "level_1_spells_list",
        resource_stat = "level_1_spells",
        resource_set_stat = "spells",
        resource_id = "spell",
        header_view = text(
          id = "level_1_title",
          margin_left = 12,
          text = "Level 1",
          style = "subhead",
          is_visible = !isEmpty(level_1_spells),
        ),
      ),
      resourceSection(
        id = "level_2_spells_list",
        resource_stat = "level_2_spells",
        resource_set_stat = "spells",
        resource_id = "spell",
        header_view = text(
          id = "level_2_title",
          margin_left = 12,
