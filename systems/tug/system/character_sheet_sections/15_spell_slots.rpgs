character_sheet_section spell_slots() =
  section(
    id = "spell_slots_section",
    show_divider = true,
    content_item_min_width = 1,
    collapsible = true,
    header = [
      icon(
        id = "spell_slots_section_icon",
        name = "ic_whatshot",
        color = "#7b1fa2",
        size = "medium",
        margin_top = 8,
        margin_right = 8,
        margin_left = 16,
      ),
      text(
        id = "spell_slots_section_title",
        margin_right = 16,
        margin_left = 16,
        text = "Spells & Mana",
        style = "title",
      ),
    ],
    content = [
      // Spell Points pool
      ticker(
        id = "current_spell_points_ticker",
        stat = "current_spell_points",
        style = "title",
        button_location = "right",
        button_look = "plusMinus",
        should_auto_save = true,
        change_amount = 1,
        min_value_allowed = 0,
        label = concat(["/ ", max_spell_points, " SP"]),
        label_alignment = "right",
        edit_bottom_sheet_title = "Current Spell Points",
        margin_left = 16,
      ),
      stat(
        id = "max_spell_points_stat",
        stat = "max_spell_points",
        change_amount = 1,
        min_value_allowed = 0,
        override_label = "Max SP (set manually)",
        edit_bottom_sheet_title = "Maximum Spell Points (set based on level and class features)",
      ),
      // Spellcasting ability
      composite(
        id = "spellcasting_ability_row",
        margin_left = 16,
        margin_top = 12,
        subviews = [
          text(
            id = "spellcasting_ability_label",
            text = "Spellcasting: ",
            style = "text",
            bold = true,
          ),
          text(
            id = "spellcasting_ability_value",
            text = concat([
              enumeratedName(enumerated_type = "ability", id = spellcasting_ability) ?? spellcasting_ability,
              "  |  Attack: +", spell_attack_bonus, "  |  DC: ", spell_save_dc_spells,
            ]),
            style = "text",
          ),
        ],
      ),
      // Spell point conversion reference
      text(
        id = "sp_conversion_title",
        text = "Spell Slot Cost (SP)",
        style = "subhead",
        bold = true,
        margin_top = 16,
        margin_left = 16,
      ),
      text(
        id = "sp_conversion_table",
        text = concat([
          "1st: 2 SP   |  2nd: 3 SP   |  3rd: 5 SP\n",
          "4th: 6 SP   |  5th: 7 SP   |  6th: 9 SP\n",
          "7th: 10 SP  |  8th: 11 SP  |  9th: 13 SP",
          (if efficient_sorcery_reduction > 0 then concat(["\n\nEfficient Sorcery: -", efficient_sorcery_reduction, " SP per spell"]) else ""),
          (if potent_sorcery_bonus > 0 then concat(["\nPotent Sorcery: +", potent_sorcery_bonus, " damage per spell level"]) else ""),
        ]),
        style = "text",
        margin_left = 16,
        margin_right = 16,
        margin_top = 8,
      ),
      // Arcane Affinity note
      text(
        id = "aa_spellcasting_note",
        text = concat(["Arcane Affinity: +", proficiency_bonus, " bonus added to spell damage rolls."]),
        style = "caption",
        margin_left = 16,
        margin_top = 8,
        is_visible = arcane_affinity_active,
      ),
      // Crimson Recovery shortcut (Blood Manipulation SP recovery)
      text(
        id = "crimson_recovery_sp_note",
        text = concat([
          "Crimson Recovery available — see Cursed Pacts section to spend HP for SP.",
        ]),
        style = "caption",
        margin_left = 16,
        margin_top = 8,
        is_visible = blood_manipulation_active && bm_crimson_recovery_pp > 0,
      ),
    ],
  );
